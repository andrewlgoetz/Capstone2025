# Copy this file to .env and fill in your values.
# Never commit .env — only .env.example.

# PostgreSQL connection string
# Local:      postgresql+psycopg2://username:password@localhost:5432/dbname
# Docker:     postgresql+psycopg2://myuser:mypassword@db:5432/inventory_db
# Render:     (copy the "Internal Database URL" from your Render Postgres dashboard)
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/dbname

# Secret key for signing JWT tokens — REQUIRED, app will not start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Comma-separated list of allowed frontend origins (in addition to localhost dev servers).
# Add your deployed frontend URL and any mobile Expo URLs here.
# Example: CORS_ORIGINS=https://app.myfoodbank.org,exp://192.168.1.10:8081
CORS_ORIGINS=
